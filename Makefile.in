prefix = @prefix@
bindir = @bindir@
mandir = @mandir@
CXX = @CXX@
CXXFLAGS = @CXXFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@

WARNFLAGS = -Wall -Wextra -Wpedantic
STD = -std=c++23

TARGET = modern-ices
SRCS = \
	src/AudioDecoder.cpp \
	src/Config.cpp \
	src/Crossfader.cpp \
	src/FlacDecoder.cpp \
	src/IcecastClient.cpp \
	src/LameEncoder.cpp \
	src/Mp3Decoder.cpp \
	src/Playlist.cpp \
	src/Streamer.cpp \
	src/TrackMetadata.cpp \
	src/VorbisDecoder.cpp \
	src/main.cpp
OBJS = $(SRCS:.cpp=.o)
DEPS = $(OBJS:.o=.d)

.PHONY: all clean install uninstall

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

%.o: %.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(WARNFLAGS) $(STD) -MMD -MP -c -o $@ $<

install: $(TARGET)
	mkdir -p "$(DESTDIR)$(bindir)"
	install -m 0755 $(TARGET) "$(DESTDIR)$(bindir)/$(TARGET)"
	mkdir -p "$(DESTDIR)$(mandir)/man1"
	install -m 0644 doc/modern-ices.1 "$(DESTDIR)$(mandir)/man1/modern-ices.1"

uninstall:
	rm -f "$(DESTDIR)$(bindir)/$(TARGET)"
	rm -f "$(DESTDIR)$(mandir)/man1/modern-ices.1"

clean:
	rm -f $(TARGET) $(OBJS) $(DEPS)

-include $(DEPS)
